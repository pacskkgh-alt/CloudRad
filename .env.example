# ============================================
# CloudRad Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- PostgreSQL Database ---
POSTGRES_USER=cloudrad_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=cloudrad_db

# --- JWT Authentication ---
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_64_CHARS
JWT_EXPIRE_MINUTES=480

# --- Orthanc PACS ---
ORTHANC_URL=http://cloudrad_orthanc:8042

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend URL (for QR code in PDF reports) ---
FRONTEND_URL=http://localhost:5173

# --- Orthanc PACS Credentials ---
ORTHANC_USER=CHANGE_ME_ORTHANC_USERNAME
ORTHANC_PASSWORD=CHANGE_ME_ORTHANC_PASSWORD
